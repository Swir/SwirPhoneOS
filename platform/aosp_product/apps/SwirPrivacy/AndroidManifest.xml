<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.swir.phoneos.privacy">
    <queries>
        <package android:name="org.swir.phoneos.launcher" />
        <package android:name="org.swir.phoneos.settings" />
        <package android:name="org.swir.phoneos.files" />
        <package android:name="org.swir.phoneos.update" />
        <package android:name="org.swir.phoneos.device_care" />
        <package android:name="org.swir.phoneos.swirroot" />
    </queries>
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/ic_privacy"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.SwirPhoneOS">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
