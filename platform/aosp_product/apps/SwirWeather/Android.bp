android_app {
    name: "SwirWeather",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: ["SwirDesign"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    min_sdk_version: "35",
    certificate: "platform",
    product_specific: true,
    optimize: { enabled: false },
}
