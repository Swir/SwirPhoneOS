<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SwirPhoneOS" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/swir_background</item>
        <item name="android:colorAccent">@color/swir_accent</item>
        <item name="android:navigationBarColor">@color/swir_background</item>
        <item name="android:statusBarColor">@color/swir_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/swir_text_primary</item>
        <item name="android:textColorSecondary">@color/swir_text_secondary</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="SwirText.Headline" parent="@android:style/TextAppearance.Material.Headline">
        <item name="android:textColor">@color/swir_text_primary</item>
    </style>

    <style name="SwirText.Body" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/swir_text_primary</item>
    </style>

    <style name="SwirText.Secondary" parent="@android:style/TextAppearance.Material.Body2">
        <item name="android:textColor">@color/swir_text_secondary</item>
    </style>
</resources>
